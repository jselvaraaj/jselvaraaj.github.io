<div class="news selected-software">
  {% if site.software != blank %}
    {% assign software_size = site.software | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.selected_software.scrollable and software_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign software = site.software | sort: 'date' | reverse %}
        {% if include.limit and page.selected_software.limit %}
          {% assign software_limit = page.selected_software.limit %}
        {% else %}
          {% assign software_limit = software_size %}
        {% endif %}
        {% for item in software limit: software_limit %}
          <tr>
            <th scope="row" class="software-date">{{ item.date | date: '%b %Y' }}</th>
            <td>{{ item.content | remove: '<p>' | remove: '</p>' }}</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}
</div>
